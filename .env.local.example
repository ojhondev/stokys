# Copie este arquivo para .env.local e preencha com os dados reais.

# Neon (Postgres serverless) — Project Settings > Connection Details.
DATABASE_URL=

# Segredo usado para assinar o cookie de sessão. Gerar um valor aleatório longo
# (ex.: `openssl rand -hex 32`) e nunca reaproveitar entre projetos.
SESSION_SECRET=

# Chave usada para criptografar credenciais sensíveis em repouso (ex.: acessos
# de plataforma coletados no onboarding — ver docs/PRD.md, seção 4.2.1).
CREDENTIALS_ENCRYPTION_KEY=

# Asaas — pagamentos (PIX, cartão, boleto). Preencher quando sair do modo mockado.
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=

# URL onde o app roda.
NEXT_PUBLIC_APP_URL=http://localhost:3000

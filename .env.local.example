# Copie este arquivo para .env.local e preencha com os dados reais.

# Neon (Postgres serverless) — Project Settings > Connection Details.
DATABASE_URL=

# Segredo usado para assinar o cookie de sessão. Gerar um valor aleatório longo
# (ex.: `openssl rand -hex 32`) e nunca reaproveitar entre projetos.
SESSION_SECRET=

# Chave usada para criptografar credenciais sensíveis em repouso (ex.: acessos
# de plataforma coletados no onboarding — ver docs/PRD.md, seção 4.2.1).
CREDENTIALS_ENCRYPTION_KEY=

# Asaas — pagamentos (PIX, cartão, boleto). Preencher quando sair do modo mockado.
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=

# Bootstrap do primeiro usuário master (dono) — usado só uma vez pelo endpoint
# /api/seed-master, que já responde 409 depois que o master existir no banco.
MASTER_NOME=
MASTER_EMAIL=
MASTER_SENHA_INICIAL=
SEED_MASTER_TOKEN=

# URL onde o app roda.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — envio de e-mail (verificação de conta). Sem RESEND_API_KEY o envio
# cai em modo mock (loga no console) — ver src/lib/email/enviar.ts.
RESEND_API_KEY=
EMAIL_REMETENTE=nao-responda@stokys.com.br

# Google OAuth2 — Google Cloud Console > APIs & Services > Credentials.
# GOOGLE_REDIRECT_URI precisa bater exatamente com o URI autorizado lá
# (ex.: http://localhost:3000/api/auth/google/callback em dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Vercel Blob — upload de arquivo (mensagens). Gerado ao habilitar Blob no
# dashboard da Vercel.
BLOB_READ_WRITE_TOKEN=

# Comunidade Sem Estoque — convite do servidor Discord (benefício do plano
# Premium). Sem valor, a tela mostra "em breve" em vez de um link quebrado.
DISCORD_INVITE_URL=
